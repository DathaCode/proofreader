# Enforce LF line endings so files stay Linux-correct even when edited on Windows.
# Prevents CRLF from creeping into shell scripts, Dockerfiles, and configs that
# break on Ubuntu (the app is developed on Windows, deployed on Linux).
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.sql       text eol=lf
*.service   text eol=lf
*.env       text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf

# Windows-only helper scripts keep CRLF (harmless; the proxy/exe use them).
*.bat       text eol=crlf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.db  binary
