# Copy to .env and fill in real values:  cp .env.example .env
# Generate FLASK_SECRET_KEY with:  python -c "import secrets; print(secrets.token_hex(32))"

# ── PostgreSQL ──
POSTGRES_DB=sinhala_proofreader
POSTGRES_USER=sinhala_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Flask ──
FLASK_SECRET_KEY=CHANGE_ME_run_the_command_above
FLASK_ENV=production

# ── pgAdmin ──
PGADMIN_EMAIL=admin@sinhalaproof.com
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# ── App ──
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-2.0-flash
APP_NAME=Sinhala Proofreader
ALLOW_REGISTRATION=true
REQUIRE_ADMIN_APPROVAL=true
MAX_WORDS_PER_REQUEST=600
SESSION_TIMEOUT_HOURS=8
RATE_LIMIT_PER_MIN=10
