[Unit]
Description=Sinhala Proofreader Web App
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/lotus_dev/vidath/proofreader
# NOTE: docker-compose.yml lives in the webapp/ subdirectory, so it is passed
# explicitly with -f (the task's bare `docker compose up -d` would not find it
# from the repo root).
ExecStart=/usr/bin/docker compose -f webapp/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f webapp/docker-compose.yml down
Restart=on-failure
RestartSec=10
User=lotus_dev

[Install]
WantedBy=multi-user.target
